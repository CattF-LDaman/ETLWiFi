# Copy to .env and fill in. Used by the CLI, the Docker services, and compose interpolation.

# --- Privacy (required) -------------------------------------------------------
# Secret key for HMAC MAC pseudonyms. Generate once with `openssl rand -hex 32` and never
# change it: a new salt turns every device into a new pseudonym and breaks history.
MAC_HASH_SALT=

# --- Storage -----------------------------------------------------------------
# Host directory holding landing/, bronze/, silver/, gold/, serving/, state/ (compose).
ETLWIFI_DATA_DIR=/mnt/TOPHDD/etlwifi
# Pre-v2 sniffer export with raw MACs; ingested read-only and hashed in bronze.
LEGACY_CSV_HOST_PATH=/mnt/TOPHDD/my_neighborhood.csv
# Local (non-Docker) runs only:
# ETLWIFI_DATA_ROOT=data
# ETLWIFI_LEGACY_CSV=neighborhood.csv
ETLWIFI_DATASET=neighborhood
ETLWIFI_TIMEZONE=Europe/Brussels

# --- Capture -----------------------------------------------------------------
CAPTURE_INTERFACE=wlx001cf09e26ce
CAPTURE_CHANNELS=1,6,11
CAPTURE_HOP_INTERVAL=2.0
CAPTURE_FLUSH_INTERVAL=10

# --- Publishing --------------------------------------------------------------
# Portfolio base URL; defaults to http://127.0.0.1:8000 in compose. Use https://luwe.be on a VPS.
# PORTFOLIO_URL=http://127.0.0.1:8000
# Shared with the portfolio (same value in its .env). `openssl rand -hex 32`.
WIFI_INGEST_SECRET=
WORKER_LIVE_INTERVAL=30
WORKER_PIPELINE_INTERVAL=900

# --- Misc --------------------------------------------------------------------
# OUI_REFRESH_DAYS=30
# LOG_FORMAT=json
# LOG_LEVEL=INFO
